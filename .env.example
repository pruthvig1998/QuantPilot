# QuantPilot .env - copy to .env and fill in. Never commit .env to git.

# Data layer: Zetaris (local install on this Mac)
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
# Key can also live in ~/.zetaris-api-key (chmod 600) instead of here.
# ZETARIS_API_KEY=
# ZETARIS_API_KEY_FILE=~/.zetaris-api-key

# Power layer: Nemotron route - all three from the SAME route.
# Route A (NVIDIA free API - already verified working):
MODEL_BASE_URL=https://integrate.api.nvidia.com/v1
# MODEL_API_KEY=<your NVIDIA API key>
NEMOTRON_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Route B (Meterless Nightshift): superseded by the Meterless Runtime
# provider lines at the bottom of this file (organizer ruling, Oct 22).

# Power provider selection (src/integrations/llm.py):
# LLM_PROVIDER=auto | meterless | nvidia. auto (the default) uses the
# Meterless Runtime route when any METERLESS_RUNTIME_* value below is
# set, and NVIDIA direct otherwise - so leaving all of these commented
# out keeps today's working behavior exactly.
# LLM_PROVIDER=auto

# Meterless Runtime provider connection (Runtime 1.4, provider contract
# v4 - meterless.ai/engines.html). Per Sam Cummings' Oct 22 ruling this
# connection in the product satisfies the Power rule; NVIDIA stays a
# featured provider inside Nightshift, and NVIDIA direct above remains
# the dev/test default on this M1 Mac (free Nightshift edition exposes
# no callable endpoint here). Uncomment when a reachable Nightshift
# endpoint exists (M5/Windows/DGX edition, or an organizer endpoint):
# METERLESS_RUNTIME_BASE_URL=http://127.0.0.1:8088/v1
# Token: Nightshift writes it to <stateDir>/proxy-token. Paste it here,
# or point the file line at that path instead (never both needed).
# METERLESS_RUNTIME_API_KEY=<runtime token from proxy-token>
# METERLESS_RUNTIME_TOKEN_FILE=<path to proxy-token file>
# Routing-mode model id (auto, fast, deep, cheap, local, fusion, or
# meterless/<class>.<disposition>):
# METERLESS_RUNTIME_MODEL=meterless/auto

# Build layer: Meterless Engine (src/integrations/meterless_engine.py)
METERLESS_ENGINE=hmem
# METERLESS_HMEM_DIR=~/.quantpilot/hmem
